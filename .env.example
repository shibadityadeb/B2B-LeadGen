# ---------------------------------------------------------------------------
# UBM Growth Opportunity Engine — environment configuration
# Copy to `.env` and adjust. Never commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# A locally installed PostgreSQL (e.g. `brew install postgresql@16`):
DATABASE_URL=postgresql+asyncpg://ubm:ubm@localhost:5432/ubm
#
# Managed Postgres (Neon, Supabase, Heroku, Render): paste the connection
# string exactly as the provider gives it. The backend normalizes it — the
# `postgresql://` prefix becomes `postgresql+asyncpg://`, and the libpq-only
# options `sslmode` / `channel_binding` are translated to `ssl=require`,
# which is the form the async driver accepts.
#
# Neon (works pasted verbatim, pooled or direct endpoint):
# DATABASE_URL=postgresql://<user>:<password>@ep-xxx-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
#
# Supabase — use the *session pooler* string:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Search provider -------------------------------------------------------
# searxng    = local metasearch instance (recommended; see README setup).
# duckduckgo = zero-setup fallback, but the public endpoint throttles
#              automated queries aggressively and will often return nothing.
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_PORT=8888
SEARXNG_BIND_ADDRESS=127.0.0.1
# Any random string; signs SearXNG session cookies.
SEARXNG_SECRET=replace-with-a-random-string
SEARCH_RESULTS_PER_QUERY=20
SEARCH_MAX_QUERIES_PER_RUN=12
# Seconds to wait between queries — be a good citizen of the public engines.
SEARCH_DELAY_SECONDS=1.0
# Extra directory/aggregator domains to ignore, in addition to the built-in
# list. Comma-separated, e.g. somedirectory.com,anotherlisting.in
SEARCH_EXCLUDED_DOMAINS=
SEARCH_TIMEOUT_SECONDS=25

# --- Crawler ---------------------------------------------------------------
# auto = use Crawl4AI when installed, otherwise the built-in httpx crawler.
CRAWLER_PROVIDER=auto
CRAWL_MAX_PAGES=8
CRAWL_TIMEOUT_SECONDS=20
CRAWL_DELAY_SECONDS=1.0
CRAWL_RESPECT_ROBOTS=true
CRAWL_USER_AGENT=UBM-GrowthEngine/1.0 (+https://www.upshotbrandmedia.com/; research crawler)

# --- Phase 2: research ------------------------------------------------------
# How many public documents one research run may discover and retrieve.
RESEARCH_MAX_SOURCES=25
RESEARCH_MAX_PAGES_TO_CRAWL=14
RESEARCH_MAX_SEARCH_QUERIES=6
RESEARCH_RESULTS_PER_QUERY=10
# How many companies a bulk research batch processes at once.
RESEARCH_BATCH_CONCURRENCY=2

# Freshness thresholds in days. These are reporting conventions and apply
# identically to every industry.
FRESHNESS_RECENT_DAYS=30
FRESHNESS_ACTIVE_DAYS=90
FRESHNESS_OLDER_DAYS=365

# --- Phase 2: optional LLM reasoning layer ----------------------------------
# none = deterministic extraction only (the default; everything still works).
# ollama = local model, used only to structure text that was already retrieved.
LLM_PROVIDER=none
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=120

# --- Phase 3: outreach ------------------------------------------------------
# Days after an outreach is marked sent at which each follow-up falls due.
FOLLOW_UP_INTERVALS=3,7,14
OUTREACH_MAX_PERSONALIZATION_POINTS=2

# --- Phase 3: Gmail (server-side only) --------------------------------------
# From a Google Cloud OAuth "Web application" client. These are SECRETS:
# they must never be copied into a NEXT_PUBLIC_* variable or the frontend.
# The app requests only the gmail.compose scope — it can create drafts and
# cannot send mail or read your inbox.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI in the Google Cloud console exactly.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback
# Where the OAuth callback returns the user afterwards.
FRONTEND_URL=http://localhost:3000

# --- Optional local LLM -----------------------------------------------------
OLLAMA_URL=http://localhost:11434

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
